{
  "name": "ai-world-news-desk",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:restore": "node scripts/db-restore.cjs",
    "setup:autostart:windows": "node scripts/autostart-windows.js",
    "setup:autostart:mac": "node scripts/autostart-mac.js",
    "setup:autostart:linux": "node scripts/autostart-linux.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
