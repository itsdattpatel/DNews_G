<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F0"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_masthead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THE WORLD DESK · WIRE EDITION"
        android:textColor="#C0392B"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:text="Tap to inspect the latest global broadsheet dispatches and wire reports."
        android:textColor="#1A1208"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OPEN BROADSHEET READER →"
        android:textColor="#5C4E3A"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
